# ========================================
# DATABASE CONFIGURATION
# ========================================
# Database URL untuk PostgreSQL (Neon/Supabase)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://user:password@localhost:5432/kandangku"

# ========================================
# NEXTAUTH CONFIGURATION
# ========================================
# Secret key untuk signing JWT tokens
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# URL aplikasi (untuk development)
NEXTAUTH_URL="http://localhost:3000"

# Trusted domain untuk production
# NEXTAUTH_URL="https://kandangku.com"
